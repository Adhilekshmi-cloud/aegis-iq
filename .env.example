# ============================================================
# Aegis Knowledge System — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ============================================================


# === LLM API Configuration (OPTIONAL) ===
# The system works fully without this key using deterministic
# rule-based answers from extracted facts (no hallucination).
# Adding a key enables LLM-enhanced natural language answers
# while still grounding every response in extracted evidence.
#
# Leave empty to run in deterministic mode (recommended for
# air-gapped or cost-sensitive environments):
OPENAI_API_KEY=

# OpenAI-compatible endpoint — works with OpenAI, Azure OpenAI,
# Ollama, LM Studio, Groq, Anyscale, Together AI, etc.:
OPENAI_BASE_URL=https://api.openai.com/v1

# Model name (must be available at the endpoint above):
OPENAI_MODEL=gpt-4o-mini


# === Embedding Model ===
# Sentence Transformers model downloaded locally (no API key needed).
EMBEDDING_MODEL=all-MiniLM-L6-v2


# === Database ===
DATABASE_URL=sqlite+aiosqlite:///./aegis_knowledge.db


# === Application ===
CORS_ORIGINS=["http://localhost:5173"]
DATA_DIR=../data/aegis-dataset
LOG_LEVEL=INFO
FAISS_INDEX_PATH=./faiss_index


# === Optional: Tesseract OCR ===
# Path to tesseract binary if it is not on PATH.
# TESSERACT_CMD=/usr/bin/tesseract


# ============================================================
# ANSWER MODES
# ============================================================
#
# OPENAI_API_KEY empty  →  Deterministic mode
#   • Facts extracted by regex patterns from ingested documents
#   • Answers built from structured facts — fast, free, zero hallucination
#   • Conflicts, evidence citations, and confidence scores still returned
#
# OPENAI_API_KEY set    →  LLM-enhanced mode
#   • Same extraction and conflict detection pipeline runs first
#   • Structured facts are passed to the LLM as grounding context
#   • LLM writes natural language — cannot fabricate beyond provided facts
#   • Falls back to deterministic mode automatically if the API call fails
#
# Both modes return the same QueryResponse schema with full provenance.
# ============================================================
